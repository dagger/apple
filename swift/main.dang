"""
Build and test cross-platform Swift packages in Linux containers.
"""
type Swift {
  """
  The Swift toolchain image.
  """
  baseImageAddress: String! = "swift:6.0-noble"

  """
  Optional container with Swift and additional system dependencies installed.
  """
  base: Container

  """
  Arguments appended to swift build, for example ["--configuration", "release"].
  """
  buildFlags: [String!]! = []

  """
  Arguments appended to swift test, for example ["--filter", "SignalsTests"].
  """
  testFlags: [String!]! = []

  """
  Environment variables for builds and tests, as KEY=VALUE.
  """
  environment: [String!]! = []

  """
  Workspace-root include patterns mounted alongside each package at their original
  relative paths. Use for local package dependencies and shared test fixtures.
  """
  includeExtraFiles: [String!]! = []

  """
  Workspace-relative package directory paths or globs to discover. Empty includes all packages.
  """
  packageInclude: [String!]! = []

  """
  Workspace-relative package directory paths or globs to exclude from discovery. Exclusions win.
  """
  packageExclude: [String!]! = []

  """
  Swift packages visible from the working directory, keyed by workspace-relative root.
  """
  packages(ws: Workspace!): SwiftPackages! {
    # findRoots does not apply gitignore rules itself. Filter against a single
    # manifest-only snapshot so ignored packages cannot become broken checks.
    let snapshot = ws.directory(
      "/",
      include: ["**/Package.swift"],
      exclude: excludes,
      gitignore: true,
    )
    let included = if (packageInclude.length == 0) {
      snapshot.glob("**/Package.swift")
    } else {
      matchingManifests(snapshot, packageInclude)
    }
    let excluded = matchingManifests(snapshot, packageExclude)
    let manifests = included.filter { path => excluded.contains(path) == false }
    SwiftPackages(
      paths: sorted(
        ws
          .findRoots(
            markers: ["Package.swift"],
            exclude: ["**/.build/**", "**/node_modules/**", "**/DerivedData/**"],
          )
          .map { path => workspacePath(ws, path) }
          .filter { path => manifests.contains(if (path == ".") { "Package.swift" } else { path + "/Package.swift" }) }
          .uniq,
      ),
      tool: self,
    )
  }

  # Append the marker so globs match complete package directories, not source
  # files or path prefixes. Use Dagger's glob semantics on the same root snapshot
  # regardless of cwd, and retain its gitignore and generated-directory exclusions.
  let matchingManifests(snapshot: Directory!, patterns: [String!]!): [String!]! {
    let empty: [String!]! = []
    patterns.reduce(empty) { acc, pattern =>
      let path = pattern.trimPrefix("./").trimSuffix("/")
      acc + snapshot.glob(if (path == "." or path == "") { "Package.swift" } else { path + "/Package.swift" })
    }.uniq
  }

  """
  Select a package by a path relative to the working directory.
  """
  package(ws: Workspace!, path: String!): SwiftPackage! {
    SwiftPackage(path: workspacePath(ws, path), tool: self)
  }

  # Collection keys remain relative to the workspace root even from a nested cwd.
  let workspacePath(ws: Workspace!, path: String!): String! {
    if (path.hasPrefix("/")) { raise "Package paths must be relative to the working directory" }
    let empty: [String!]! = []
    let segments = (ws.cwd.split("/") + path.split("/"))
      .filter { part => part != "" and part != "." }
      .reduce(empty) { acc, part =>
        if (part == "..") {
          if (acc.length == 0) { raise "Package path leaves the workspace" }
          acc.dropLast(1)
        } else {
          acc + [part]
        }
      }
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  # Byte order, matching the indexer's result ranks. Merge sort keeps the
  # per-check work O(n log n): every test check sorts its package's selection.
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }

  let excludes: [String!]! = ["**/.git", "**/.build", "**/node_modules", "**/DerivedData", "**/xcuserdata"]

  # The pinned image the helper is built and the scan runs in.
  let helperImage: String! = "golang:1.27.3-alpine"

  # The module's helper (helpers/swift-tests): `scan` lists tests from source
  # and `report` splits a shared swift test run into per-check results. A
  # static binary built once in a pinned image, so it runs in any base
  # container and is identical for every check.
  let helper: File! {
    container
      .from(helperImage)
      .withEnvVariable("CGO_ENABLED", "0")
      .withEnvVariable("GOTOOLCHAIN", "local")
      .withDirectory("/helpers/swift-tests", currentModule.source.directory("helpers/swift-tests"))
      .withWorkdir("/helpers/swift-tests")
      .withExec(["go", "build", "-trimpath", "-o", "/usr/local/bin/swift-tests", "."])
      .file("/usr/local/bin/swift-tests")
  }

  # Compilation conditions test discovery evaluates #if blocks with: -D flags
  # passed through -Xswiftc in testFlags, and DEBUG unless the configuration
  # is release, as SwiftPM sets them.
  let compilationConditions: [String!]! {
    let empty: [String!]! = []
    let state = testFlags.reduce({{previous: "", names: empty, release: false}}) { acc, arg =>
      let define = acc.previous == "-Xswiftc" and arg.hasPrefix("-D") and arg != "-D"
      let release = ((acc.previous == "-c" or acc.previous == "--configuration") and arg == "release")
        or arg == "--configuration=release"
        or arg == "-c=release"
      {{
        previous: arg,
        names: if (define) { acc.names + [arg.trimPrefix("-D")] } else { acc.names },
        release: acc.release or release
      }}
    }
    sorted((state.names + (if (state.release) { empty } else { ["DEBUG"] })).uniq)
  }

  # One source-only scan of every package's tests in the workspace. It runs no
  # SwiftPM, resolves no dependencies and compiles nothing, in a pinned image
  # whose inputs are the workspace's Swift files and the compilation
  # conditions, so every package reads its slice of the same result.
  let discovery(ws: Workspace!): Directory! {
    container
      .from(helperImage)
      .withFile("/usr/local/bin/swift-tests", helper)
      .withMountedDirectory(
        "/ws",
        ws.directory("/", include: ["**/*.swift"], exclude: excludes, gitignore: true),
      )
      .withExec(["swift-tests", "scan", "--root", "/ws", "--output", "/discovery"]
        + compilationConditions.map { name => "--define=" + name })
      .directory("/discovery")
  }

  # A package's discovered tests and the file discovery could not read, if any.
  let discoveredTests(ws: Workspace!, path: String!): {{tests: [String!]!, error: String!}}! {
    let scanned = discovery(ws)
    let roots = JSON.decode(scanned.file("roots.json").contents) :: [String!]!
    if (roots.contains(path)) {
      let rank = roots.filter { root => root < path }.length
      JSON.decode(scanned.file("packages/" + toString(rank) + ".json").contents) :: {{tests: [String!]!, error: String!}}!
    } else {
      let empty: [String!]! = []
      {{tests: empty, error: path + "/Package.swift: not found"}}
    }
  }

  let runner(ws: Workspace!, package: SwiftPackage!): Container! {
    let workdir = if (package.path == ".") { "/src" } else { "/src/" + package.path }
    let ctr = (base ?? container.from(baseImageAddress))
      .withDirectory(workdir, package.source(ws))
      .withWorkdir(workdir)
    let withExtras = if (includeExtraFiles.length == 0) { ctr } else {
      ctr.withDirectory(
        "/src",
        ws.directory("/", include: includeExtraFiles, exclude: excludes, gitignore: true),
      )
    }
    environment.reduce(withExtras) { acc, pair =>
      let key = pair.split("=")[0] ?? ""
      if (pair.contains("=") == false or key == "") {
        raise "Environment variables must be KEY=VALUE: " + pair
      }
      acc.withEnvVariable(key, pair.trimPrefix(key + "="))
    }
  }

  let failure(ws: Workspace!, package: SwiftPackage!, command: String!): String {
    {
      let flags = if (command == "test") { testFlags } else { buildFlags }
      let ran = runner(ws, package)
        .withExec(["swift", command] + flags, expect: ReturnType.ANY)
      commandFailure(ran, "swift " + command)
    } rescue {
      err: Error => err.message
    }
  }

  let commandFailure(ran: Container!, command: String!): String {
    if (ran.exitCode == 0) { null } else {
      command + " failed (exit " + toString(ran.exitCode) + "):\n"
        + "stdout:\n" + ran.stdout.trim(" \n").split("\n").takeLast(30).join("\n")
        + "\nstderr:\n" + ran.stderr.trim(" \n").split("\n").takeLast(30).join("\n")
    }
  }

  # Strip only named options, including their values, without splitting arguments
  # containing spaces. Both --option=value and --option value are accepted.
  let withoutOptions(args: [String!]!, values: [String!]!, switches: [String!]!): [String!]! {
    let empty: [String!]! = []
    args.reduce({{skipNext: false, args: empty}}) { state, arg =>
      let name = arg.split("=")[0] ?? ""
      if (state.skipNext) {
        {{skipNext: false, args: state.args}}
      } else if (values.contains(name)) {
        {{skipNext: arg.contains("=") == false, args: state.args}}
      } else if (switches.contains(name)) {
        {{skipNext: false, args: state.args}}
      } else {
        {{skipNext: false, args: state.args + [arg]}}
      }
    }.args
  }

  let exactFilter(names: [String!]!): String! {
    let special = ["\\", ".", "^", "$", "|", "?", "*", "+", "(", ")", "[", "]", "{", "}"]
    # Swift Testing IDs end in a /file:line:column suffix that discovery omits.
    # Match that boundary as well as end-of-ID.
    "^(" + names.map { name =>
      name.split("").map { char => if (special.contains(char)) { "\\" + char } else { char } }.join("")
    }.join("|") + ")(/|$)"
  }
}

"""
Swift packages keyed by their workspace-relative roots.
"""
type SwiftPackages @collection {
  paths: [String!]! @keys
  let tool: Swift!

  """
  The package at a workspace-relative root.
  """
  package(path: String!): SwiftPackage! @get {
    SwiftPackage(path: path, tool: tool)
  }

  """
  Build the selected packages. A plain helper: each package's build check
  already runs during dagger check.
  """
  build(ws: Workspace!): Void {
    run(ws, "build")
  }

  """
  Run the selected packages' tests, one swift test per package.
  """
  test(ws: Workspace!): Void {
    run(ws, "test")
  }

  let run(ws: Workspace!, command: String!): Void {
    # Selection evaluates packages concurrently and collects every failure.
    let failures = paths.map { path => package(path) }.{{path, failure(ws, command)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Swift package " + command + " failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }
}

"""
A Swift package rooted at a workspace-relative path.
"""
type SwiftPackage {
  path: String!
  let tool: Swift!

  """
  Package source, excluding host build products and gitignored files.
  """
  source(ws: Workspace!): Directory! {
    ws.directory(
      if (path == ".") { "/" } else { "/" + path },
      exclude: tool.excludes,
      gitignore: true,
    )
  }

  """
  A Swift container with the package mounted and its working directory set.
  """
  container(ws: Workspace!): Container! {
    tool.runner(ws, self)
  }

  """
  Test identifiers, discovered from source the way swift test list names them,
  without running SwiftPM or compiling. Parameterized Swift Testing functions
  are one item, running all their cases.
  """
  tests(ws: Workspace!): SwiftTests! {
    SwiftTests(names: tool.sorted(tool.discoveredTests(ws, path).tests.uniq), package: self)
  }

  """
  Why test discovery could not read this package, naming the file, or null.
  """
  discoveryFailure(ws: Workspace!): String {
    let error = tool.discoveredTests(ws, path).error
    if (error == "") { null } else { error }
  }

  """
  Compile this package for Linux with swift build.

  A package whose tests could not be discovered fails here, rather than
  stopping every check.
  """
  build(ws: Workspace!): Void @check {
    let failure = discoveryFailure(ws)
    if (failure != null) { raise "Swift package " + path + ": test discovery failed: " + (failure ?? "") }
    run(ws, "build")
  }

  """
  Run this package's XCTest and Swift Testing tests with swift test.
  """
  test(ws: Workspace!): Void {
    run(ws, "test")
  }

  let failure(ws: Workspace!, command: String!): String {
    tool.failure(ws, self, command)
  }

  let run(ws: Workspace!, command: String!): Void {
    let error = failure(ws, command)
    if (error != null) { raise "Swift package " + path + ": " + (error ?? "") }
    null
  }

  """
  One swift test command and report shared by every selected test in this
  package. It depends only on the selection, never on the calling check, so
  every check in the package builds the same command and the engine runs it once.
  """
  let runTests(ws: Workspace!, selection: SwiftTests!): SwiftTestResults! {
    let names = tool.sorted(selection.names.uniq)
    if (names.length == 0) { raise "no tests selected in Swift package " + path }
    let whole = selection.narrowed == false
    let configured = if (whole) {
      tool.testFlags
    } else {
      tool.withoutOptions(tool.testFlags, ["--filter", "--specifier", "-s"], [])
        + ["--filter", tool.exactFilter(names)]
    }
    let flags = tool.withoutOptions(
      configured,
      ["--xunit-output", "--event-stream-output-path", "--event-stream-version"],
      [],
    )
    # swift test builds the package first: a compile error is this run's to
    # report, against the package's selected tests. Never raise here: a raise
    # would fail every check identically.
    let executed = container(ws).withExec(
      ["swift", "test"] + flags + [
        "--xunit-output", "/tmp/dagger-swift-test-xunit.xml",
        "--event-stream-output-path", "/tmp/dagger-swift-test-events.jsonl",
        "--event-stream-version", "0",
      ],
      expect: ReturnType.ANY,
      redirectStdout: "/tmp/dagger-swift-test-stdout.log",
      redirectStderr: "/tmp/dagger-swift-test-stderr.log",
    )
    # testFlags may exclude a selected test on purpose. Otherwise a selected
    # test without a result fails as not run.
    let options = tool.testFlags.map { flag => flag.split("=")[0] ?? "" }
    let allowUnrun = options.contains("--skip")
      or (whole and (options.contains("--filter") or options.contains("--specifier") or options.contains("-s")))
    # Only post-processing needs root. The test command above keeps the custom
    # base's configured user.
    let indexed = executed
      .withUser("0:0")
      .withFile("/usr/local/bin/swift-tests", tool.helper)
      .withNewFile("/tmp/dagger-swift-test-selection.json", JSON.encode({{
        names,
        allowUnrun
      }}))
      .withExec([
        "/usr/local/bin/swift-tests",
        "report",
        "--selection", "/tmp/dagger-swift-test-selection.json",
        "--stdout", "/tmp/dagger-swift-test-stdout.log",
        "--stderr", "/tmp/dagger-swift-test-stderr.log",
        "--events", "/tmp/dagger-swift-test-events.jsonl",
        "--xunit", "/tmp/dagger-swift-test-xunit.xml",
        "--exit-code", `${executed.exitCode}`,
        "--output", "/tmp/dagger-swift-test-results",
      ])
    SwiftTestResults(
      results: indexed.directory("/tmp/dagger-swift-test-results"),
      names: names,
      path: path,
    )
  }
}

"""
Tests in a Swift package, keyed by the identifiers reported by SwiftPM.
"""
type SwiftTests @collection {
  names: [String!]! @keys

  """
  Tests selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed tests from this collection. Without a
  delta (a direct API call), the explicit filter is the safe choice.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  let package: SwiftPackage!

  """
  The test with this SwiftPM identifier.
  """
  testCase(name: String!): SwiftTest! @get {
    SwiftTest(name: name, suite: self)
  }

  """
  Run these tests in one swift test invocation and report every failing test.
  A narrowed selection overrides testFlags' filter or specifier; skip flags
  still apply. An empty selection runs nothing. A plain helper: each test has
  its own check.
  """
  test(ws: Workspace!): Void {
    if (names.length > 0) {
      let failures = package.runTests(ws, self).failures
      if (failures.length > 0) {
        raise "Swift package " + package.path + ": " + `${failures.length}` + " failed:\n" + failures.join("\n")
      }
    }
    null
  }
}

"""
A test function in a Swift package.
"""
type SwiftTest {
  name: String!
  let suite: SwiftTests!

  """
  Run this test, or all cases of this parameterized test function.

  Every selected test in the package shares one swift test run.
  """
  test(ws: Workspace!, selection: SwiftTests!): Void @check {
    if (selection.package.path != suite.package.path) {
      raise "Swift test selection belongs to package " + selection.package.path + ", not " + suite.package.path
    }
    selection.package.runTests(ws, selection).assertPassed(name)
  }
}

# The shared indexer keeps each result small, regardless of total report size.
type SwiftTestResults {
  let results: Directory!
  # The selection, sorted in byte order. A result file is named by its rank.
  let names: [String!]!
  let path: String!

  let failure(name: String!): String! {
    if (names.contains(name) == false) { raise "Swift test is outside the selection: " + name }
    results.file(`${names.filter { other => other < name }.length}`).contents
  }

  let assertPassed(name: String!): Void {
    let message = failure(name)
    if (message != "") { raise "Swift package " + path + ": " + message }
    null
  }

  let failures: [String!]! {
    names.map { name => failure(name) }.filter { message => message != "" }
  }
}
